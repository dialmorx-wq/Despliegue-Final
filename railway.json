{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd proyecto_springboot/SGA_RPF_COPIA && chmod +x mvnw && ./mvnw -DskipTests package"
  },
  "deploy": {
    "startCommand": "java -Dserver.port=$PORT -jar proyecto_springboot/SGA_RPF_COPIA/target/*.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}